      "args": ["build"],
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] }
      },
      "dependsOn": ["Build Tests"],
      "group": "test",
      "problemMatcher": [],
