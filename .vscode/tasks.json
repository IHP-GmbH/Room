{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Configure Debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S", ".",
        "-B", "build",
        "-G", "MinGW Makefiles",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DCMAKE_C_COMPILER=C:/Qt/Tools/mingw810_64/bin/gcc.exe",
        "-DCMAKE_CXX_COMPILER=C:/Qt/Tools/mingw810_64/bin/g++.exe",
        "-DCMAKE_MAKE_PROGRAM=C:/Qt/Tools/mingw810_64/bin/mingw32-make.exe"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": false },
      "problemMatcher": "$cmake",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "CMake: Configure Release",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S", ".",
        "-B", "build",
        "-G", "MinGW Makefiles",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_C_COMPILER=C:/Qt/Tools/mingw810_64/bin/gcc.exe",
        "-DCMAKE_CXX_COMPILER=C:/Qt/Tools/mingw810_64/bin/g++.exe",
        "-DCMAKE_MAKE_PROGRAM=C:/Qt/Tools/mingw810_64/bin/mingw32-make.exe"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": false },
      "problemMatcher": "$cmake",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Build: Static Libraries (.a)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build", "build", "-j4",
        "--target", "core", "core_utils"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["CMake: Configure Debug"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$gcc",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Build: Release Libraries (.a)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build", "build", "-j4",
        "--target", "core", "core_utils"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["CMake: Configure Release"],
      "group": { "kind": "build", "isDefault": false },
      "problemMatcher": "$gcc",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Build: All Targets",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "build", "-j4"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["CMake: Configure Debug"],
      "problemMatcher": "$gcc",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Install: Libraries + Headers",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--install", "build",
        "--prefix", "${workspaceFolder}/install"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["Build: All Targets"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Example: Make Sample GDS",
      "type": "shell",
      "command": "if not exist testdata mkdir testdata & build\\make_sample_gds.exe testdata\\sample.gds",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        }
      },
      "dependsOn": ["Build: All Targets"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Example: GDS to CORE",
      "type": "shell",
      "command": "if not exist examples\\gds_to_core\\output mkdir examples\\gds_to_core\\output & build\\gds_to_core.exe",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        }
      },
      "dependsOn": ["Build: All Targets"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "showReuseMessage": false,
        "close": false
      }
    },
    {
      "label": "Run Demo: GDS to CORE",
      "type": "process",
      "command": "${workspaceFolder}/build/gds_to_core.exe",
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["Ensure: gds_to_core output dir"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "showReuseMessage": false,
        "close": false
      }
    },
    {
      "label": "Ensure: gds_to_core output dir",
      "type": "shell",
      "command": "if not exist examples\\gds_to_core\\output mkdir examples\\gds_to_core\\output",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        }
      },
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared", "close": true }
    },
    {
      "label": "Example: Qucs to CORE",
      "type": "shell",
      "command": "if not exist examples\\qucs_to_core\\output mkdir examples\\qucs_to_core\\output & build\\qucs_to_core.exe",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        }
      },
      "dependsOn": ["Build: All Targets"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "showReuseMessage": false,
        "close": false
      }
    },
    {
      "label": "Run Demo: Qucs to CORE",
      "type": "process",
      "command": "${workspaceFolder}/build/qucs_to_core.exe",
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["Ensure: qucs_to_core output dir"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "showReuseMessage": false,
        "close": false
      }
    },
    {
      "label": "Ensure: qucs_to_core output dir",
      "type": "shell",
      "command": "if not exist examples\\qucs_to_core\\output mkdir examples\\qucs_to_core\\output",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        }
      },
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared", "close": true }
    },
    {
      "label": "Build: gds_core_roundtrip",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "build", "--target", "gds_core_roundtrip"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["CMake: Configure Debug"],
      "problemMatcher": "$gcc",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Test: sample GDS round-trip",
      "type": "shell",
      "command": "scripts\\run_sample_gds_roundtrip_test.cmd",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        }
      },
      "dependsOn": ["Build: gds_core_roundtrip"],
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": false },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "showReuseMessage": false,
        "close": false
      }
    },
    {
      "label": "Test: sg13g2_stdcell GDS round-trip",
      "type": "shell",
      "command": "scripts\\run_sg13g2_stdcell_gds_roundtrip_test.cmd",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        }
      },
      "dependsOn": ["Build: gds_core_roundtrip"],
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": false },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "showReuseMessage": false,
        "close": false
      }
    },
    {
      "label": "Example: Build & Run Full Demo",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Build: All Targets",
        "Run Demo: GDS to CORE"
      ],
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "showReuseMessage": false,
        "close": false
      }
    }
  ]
}
