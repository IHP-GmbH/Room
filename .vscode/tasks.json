    },
    {
      "label": "Run Test: oas_room_roundtrip",
      "type": "shell",
      "command": "scripts\\run_oas_room_roundtrip_test.cmd",
      "args": ["build"],
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] }
      },
      "dependsOn": ["Build Tests"],
      "group": "test",
      "problemMatcher": [],
