v {xschem version=3.4.5 file_version=1.2}
G {}
K {type=subcircuit
format="@name @@OUT @@IN @@VDD @@VSS @symname"
template="name=x1"}
V {}
S {}
E {}
B 4 -40 -40 40 40 {}
B 5 -42.5 -2.5 -37.5 2.5 {name=IN dir=in}
B 5 37.5 -2.5 42.5 2.5 {name=OUT dir=out}
B 5 -2.5 -42.5 2.5 -37.5 {name=VDD dir=inout}
B 5 -2.5 37.5 2.5 42.5 {name=VSS dir=inout}
